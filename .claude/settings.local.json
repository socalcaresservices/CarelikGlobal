{
  "allow": [
    "Bash(git:*)",
    "Bash(gh:*)",
    "Bash(pnpm:*)",
    "Bash(npm:*)",
    "Bash(npx cdk synth:*)",
    "Bash(npx cdk diff:*)",
    "Bash(cdk synth:*)",
    "Bash(cdk diff:*)",
    "Bash(aws sts:*)",
    "Bash(aws cloudformation describe:*)",
    "Bash(aws cloudformation list:*)",
    "Bash(cat:*)",
    "Bash(ls:*)",
    "Bash(df:*)",
