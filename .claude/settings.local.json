{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx cdk synth:*)",
      "Bash(npx cdk diff:*)",
      "Bash(cdk synth:*)",
      "Bash(cdk diff:*)",
      "Bash(aws sts:*)",
      "Bash(aws cloudformation describe:*)",
      "Bash(aws cloudformation list:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(df:*)",
      "Bash(mkdir:*)",
      "Bash(cd:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr merge:*)", "Bash(gh release:*)"],
    "deny": [
      "Bash(cdk deploy:*)",
      "Bash(npx cdk deploy:*)",
      "Bash(cdk destroy:*)",
      "Bash(npx cdk destroy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)"
    ]
  }
}
