{
  "name": "@carelik/infra-aws",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ogevia AWS infrastructure (CDK v2). Synth only - deploys require owner approval per CLAUDE.md section 13.",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet -c env=prod -c mode=plan",
    "cdk": "cdk",
    "inventory": "tsx scripts/synth-inventory.ts",
    "diff:template": "cdk diff --method=template --lookups=false -c env=prod -c mode=plan --profile ogevia-readonly",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx db/scripts/migrate.ts",
    "db:verify": "tsx db/scripts/verify.ts",
    "db:rollback-readiness": "tsx db/scripts/rollback.ts",
    "user-migration:plan": "tsx scripts/user-migration-plan.ts",
    "harness:setup": "tsx local-harness/setup.ts",
    "harness:build": "tsx local-harness/build-web.ts",
    "harness:serve": "tsx local-harness/serve.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@carelik/sv-api": "workspace:^",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "aws-cdk": "2.1143.0",
    "esbuild": "0.25.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
