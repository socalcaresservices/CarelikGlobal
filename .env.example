VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Read by the Supabase CLI (supabase start) from a root .env file.
# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL http://127.0.0.1:54321/auth/v1/callback for local development.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Stripe (not configured in this project yet - the billing system works
# fully without these; the platform owner's Billing page shows a
# "Stripe configuration required" status until they're set). Never put
# STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET in a VITE_-prefixed
# variable - both must stay server-only (a Supabase Edge Function
# secret, not a frontend env var). VITE_STRIPE_PUBLISHABLE_KEY is
# Stripe's publishable key, which is designed to be public and is the
# only Stripe value that belongs in frontend code.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
