VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Read by the Supabase CLI (supabase start) from a root .env file.
# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL http://127.0.0.1:54321/auth/v1/callback for local development.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Stripe. Real checkout/webhook edge functions exist
# (supabase/functions/create-checkout-session, create-portal-session,
# stripe-webhook) but do nothing until these are set - the platform
# owner's Plans page shows a "Stripe configuration required" status
# until then. These three values do NOT all live in the same place:
#
# - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET: server-only secrets, used
#   only inside the three edge functions above. Set these as Supabase
#   Edge Function secrets (Dashboard -> Edge Functions -> Secrets, or
#   `supabase secrets set`) - NOT in Netlify. Netlify only serves the
#   static frontend build; it has no access to the Supabase edge
#   function runtime, so setting these there would just be inert.
# - VITE_STRIPE_PUBLISHABLE_KEY: Stripe's publishable key, designed to
#   be public. This one DOES belong in Netlify's build environment
#   variables, and must keep the VITE_ prefix specifically - Vite only
#   ever exposes VITE_-prefixed vars to client code, so a plain
#   STRIPE_PUBLISHABLE_KEY set in Netlify would never reach the browser.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
