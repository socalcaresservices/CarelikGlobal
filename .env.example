VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development

# Read by the Supabase CLI (supabase start) from a root .env file.
# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL http://127.0.0.1:54321/auth/v1/callback for local development.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Stripe (Ogevia Starter subscriptions) + the Supabase credentials the
# checkout/webhook/billing-portal code needs, all as Netlify environment
# variables - apps/netlify-functions/functions/create-checkout-session.ts,
# create-billing-portal-session.ts, and stripe-webhook.ts, not Supabase
# Edge Functions. No publishable Stripe key is needed anywhere - checkout
# and the billing portal both use server-redirect Stripe-hosted pages,
# never Stripe.js. create-billing-portal-session.ts reuses every variable
# below - no new ones. Stripe's Customer Portal itself also needs its
# settings (features, cancellation policy) configured once in the Stripe
# Dashboard - that's a Stripe-side setup step, not an env var.
#
# Every variable below is a Netlify Functions-only secret (Site settings
# -> Environment variables, scoped to Functions) - never in the repo,
# never exposed to the browser, and no VITE_ prefix on any of them.
#
# STRIPE_SECRET_KEY        - Stripe sandbox secret key.
# STRIPE_STARTER_PRICE_ID  - the existing Ogevia Starter price_... id
#                            from the Stripe Dashboard (never created via
#                            API here, never accepted from the client).
# STRIPE_WEBHOOK_SECRET    - from the webhook endpoint Stripe Dashboard
#                            step, once the function URL is known.
# APP_URL                  - https://app.ogevia.com - where Checkout
#                            redirects back to after success/cancel.
# SUPABASE_URL             - same value as VITE_SUPABASE_URL above, just
#                            not browser-exposed.
# SUPABASE_PUBLISHABLE_KEY - Supabase's current low-privilege API key
#                            (sb_publishable_...), used in
#                            create-checkout-session.ts to verify the
#                            caller's own JWT and check their permission
#                            on the organization. Same RLS behavior as
#                            the legacy anon key it replaces - just an
#                            opaque token instead of a JWT. Legacy anon
#                            keys are deprecated by end of 2026:
#                            https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys
# SUPABASE_SECRET_KEY      - Supabase's current full-privilege API key
#                            (sb_secret_...), used only in
#                            stripe-webhook.ts for the one privileged
#                            write (record_stripe_subscription_event()).
#                            Replaces the legacy service_role key - same
#                            service_role Postgres privileges, genuinely
#                            sensitive, same handling as STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
